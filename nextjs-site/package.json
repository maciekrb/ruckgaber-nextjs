{
  "name": "ruckgaber-site",
  "version": "4.0.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "7.3.7",
    "@mui/material-nextjs": "^7.3.7",
    "bootstrap": "^4.6.2",
    "clsx": "^2.1.1",
